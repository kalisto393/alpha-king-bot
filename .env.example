# Frontend
FRONTEND_URL=http://localhost:3000

# Backend
PORT=5000
NODE_ENV=development

# JWT Secret (change in production!)
JWT_SECRET=your-very-secret-key-change-this-in-production-12345

# Database (if using PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/alpha_king_bot

# Redis (if using cache)
REDIS_URL=redis://localhost:6379

# Deriv API (optional - for additional services)
DERIV_API_KEY=your-deriv-api-key
DERIV_API_SECRET=your-deriv-api-secret

# AI/ML Service (future)
AI_MODEL_API_URL=http://localhost:8000/api/predict
AI_MODEL_API_KEY=your-ai-service-key

# Environment
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
